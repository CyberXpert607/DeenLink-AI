[Unit]
Description=deenlink-AI FastAPI Backend
After=network.target

[Service]
# Change this to the actual user running the app on your VPS (e.g., ubuntu, root, deen)
User=ubuntu
# Change this to the actual path where you cloned the repository
WorkingDirectory=/home/ubuntu/DeenLink-AI

# Bypass uv completely to avoid snap system profile parsing bugs
ExecStart=/home/ubuntu/DeenLink-AI/.venv/bin/python -m uvicorn src.backend.api.main:app --host 127.0.0.1 --port 8000

# Automatically restart if it crashes
Restart=always
RestartSec=5

# Set environment variables if needed, though they are loaded from .env
# Environment="PATH=/root/.cargo/bin:/usr/local/bin:/usr/bin:/bin"

[Install]
WantedBy=multi-user.target
